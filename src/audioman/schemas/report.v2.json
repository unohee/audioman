{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audioman://schema/report.v2.json",
  "title": "Audioman Report v2",
  "description": "Shared report contract attached as the top-level `report` key by analyze, observe, screen, master qc, doctor and the uat subcommands. Measurements carry a floor (the smallest meaningful difference); gates turn measurements into PASS/WARN/FAIL; a declared gate that was not produced is present as FAIL with reason \"missing\".",
  "type": "object",
  "required": [
    "schema",
    "version",
    "command",
    "subject",
    "measurements",
    "findings",
    "gates",
    "missing_gates",
    "verdict"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "audioman://schema/report.v2.json"
    },
    "version": {
      "const": "2"
    },
    "command": {
      "type": "string",
      "enum": [
        "analyze",
        "observe",
        "screen",
        "master qc",
        "doctor",
        "uat compare",
        "uat smoke",
        "uat pdc"
      ]
    },
    "subject": {
      "type": "object",
      "description": "What was measured: an audio file, a directory (batch) or a plugin (doctor).",
      "required": [
        "file",
        "sample_rate",
        "channels",
        "duration_sec"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "sample_rate": {
          "type": [
            "integer",
            "null"
          ]
        },
        "channels": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duration_sec": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit",
          "floor",
          "floor_kind",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "floor": {
            "type": [
              "number",
              "null"
            ],
            "description": "Smallest difference in value that is meaningful; null only when floor_kind is unknown."
          },
          "floor_kind": {
            "type": "string",
            "enum": [
              "exact",
              "rounding",
              "resolution",
              "quantization",
              "unknown"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "audioman://schema/finding.v1.json"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "WARN",
              "FAIL"
            ]
          },
          "measurement": {
            "type": [
              "string",
              "null"
            ],
            "description": "Name of the measurement the gate reads; omitted when none."
          },
          "threshold": {
            "description": "The pass condition as the producer states it (number, range or text); omitted when none."
          },
          "required": {
            "type": "boolean",
            "description": "Omitted when true (every gate a command declares is required)."
          },
          "reason": {
            "type": "string",
            "description": "Why the gate did not pass; \"missing\" when the producer did not emit it. Omitted when empty."
          }
        }
      }
    },
    "missing_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ],
      "description": "FAIL if any gate fails, else WARN if any warns, else PASS."
    }
  }
}

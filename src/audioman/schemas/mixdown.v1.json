{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audioman://schema/mixdown.v1.json",
  "title": "Audioman Mixdown Result",
  "description": "Output envelope for `audioman mixdown --json`. The plan variant (`--dry-run`) reports the resolved track list, master chain and optional automix analysis; the execution variant adds rendered stats. `track_count` and `tracks` are present in both.",
  "type": "object",
  "required": [
    "$schema",
    "audioman_version",
    "command",
    "track_count",
    "tracks"
  ],
  "properties": {
    "$schema": {"const": "audioman://schema/mixdown.v1.json"},
    "audioman_version": {"type": "string"},
    "command": {"const": "mixdown"},
    "track_count": {"type": "integer"},
    "tracks": {
      "type": "array",
      "items": {"type": "object"}
    },
    "master_chain": {
      "type": ["array", "null"],
      "description": "Master bus plugin chain; null when no master chain was requested.",
      "items": {"type": "object"}
    },
    "dry_run": {
      "type": ["boolean", "null"],
      "description": "Plan variant (`--dry-run`) only; always true when present."
    },
    "output": {
      "type": ["string", "null"],
      "description": "Plan variant only."
    },
    "automix": {
      "type": ["object", "null"],
      "description": "Plan variant only, and only when --automix was given."
    },
    "output_path": {
      "type": ["string", "null"],
      "description": "Execution variant only."
    },
    "master_latency_samples": {
      "type": ["integer", "null"],
      "description": "Execution variant only."
    },
    "output_stats": {
      "type": ["object", "null"],
      "description": "Execution variant only."
    },
    "sample_rate": {
      "type": ["integer", "null"],
      "description": "Execution variant only."
    },
    "duration_seconds": {
      "type": ["number", "null"],
      "description": "Execution variant only."
    },
    "clipping_detected": {
      "type": ["boolean", "null"],
      "description": "Execution variant only."
    }
  }
}
